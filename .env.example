# Stock-manager API Gateway base URL (serves GET/POST/DELETE /stocks).
VITE_API_BASE_URL=https://your-api-id.execute-api.ap-east-1.amazonaws.com

# Daily-report download URL template.
# {date} is replaced at runtime with the report date as DDMMYYYY (UTC),
# matching the backend's filename convention (report-v3-DDMMYYYY.docx).
# Point this at a different bucket/path to switch report sources — no code change.
VITE_REPORT_DOWNLOAD_URL=https://<bucket>.s3.<region>.amazonaws.com/reports/report-v3-{date}.docx
